<?xml version="1.0" encoding="utf-8"?>

<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- ========================= -->
    <!-- MAIN CONTENT -->
    <!-- ========================= -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="#F5F6F7">

        <!-- TOP TOOLBAR -->

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="#111C21"
            android:title="SmartServe"
            android:titleTextColor="@android:color/white"
            app:navigationIconTint="@android:color/white" />

        <!-- DASHBOARD CONTENT -->

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="24dp">

                <ImageView
                    android:layout_width="130dp"
                    android:layout_height="130dp"
                    android:src="@drawable/smart_serve_logo"
                    android:contentDescription="SmartServe Logo" />

                <TextView
                    android:id="@+id/tvDashboardTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="SMART SERVE"
                    android:textColor="#1B252B"
                    android:textSize="30sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvWelcome"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Welcome"
                    android:textColor="#666666"
                    android:textSize="20sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="30dp"
                    android:gravity="center"
                    android:text="Use the menu button above to access the cafeteria system."
                    android:textColor="#555555"
                    android:textSize="16sp" />

            </LinearLayout>

        </ScrollView>

    </LinearLayout>


    <!-- ====================================== -->
    <!-- SMART SERVE NAVIGATION SIDEBAR -->
    <!-- ====================================== -->

    <LinearLayout
        android:id="@+id/navigationDrawer"
        android:layout_width="250dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:orientation="vertical"
        android:background="#111C21"
        android:elevation="12dp">


        <!-- ================================= -->
        <!-- LOGO / BRANDING -->
        <!-- ================================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="125dp"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="8dp"
            android:background="#111C21">

            <ImageView
                android:layout_width="70dp"
                android:layout_height="70dp"
                android:src="@mipmap/ic_launcher"
                android:scaleType="centerInside"
                android:contentDescription="SmartServe Logo" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SMART SERVE"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginTop="2dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CAFETERIA SYSTEM"
                android:textColor="#AEB7BB"
                android:textSize="8sp"
                android:letterSpacing="0.08" />

        </LinearLayout>


        <!-- ================================= -->
        <!-- DASHBOARD -->
        <!-- ================================= -->

        <TextView
            android:id="@+id/navDashboard"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/nav_selected"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:text="▣    Dashboard"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="true" />


        <!-- ================================= -->
        <!-- FOOD MENU -->
        <!-- ================================= -->

        <TextView
            android:id="@+id/navMenu"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:layout_marginTop="3dp"
            android:background="@drawable/nav_normal"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:text="☷    Food Menu"
            android:textColor="#E6EAEC"
            android:textSize="14sp"
            android:clickable="true"
            android:focusable="true" />


        <!-- ================================= -->
        <!-- CART -->
        <!-- ================================= -->

        <TextView
            android:id="@+id/navCart"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:layout_marginTop="3dp"
            android:background="@drawable/nav_normal"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:text="▣    My Cart"
            android:textColor="#E6EAEC"
            android:textSize="14sp"
            android:clickable="true"
            android:focusable="true" />

        <!-- Orders -->

        <TextView
            android:id="@+id/navOrders"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:gravity="center_vertical"
            android:paddingStart="25dp"
            android:text="📋   Orders"
            android:textColor="#333333"
            android:textSize="18sp" />
        <!-- ================================= -->
        <!-- INVENTORY -->
        <!-- ================================= -->

        <TextView
            android:id="@+id/navInventory"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:layout_marginTop="3dp"
            android:background="@drawable/nav_normal"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:text="▤    Inventory"
            android:textColor="#E6EAEC"
            android:textSize="14sp"
            android:clickable="true"
            android:focusable="true" />


        <!-- ================================= -->
        <!-- REPORTS -->
        <!-- ================================= -->

        <TextView
            android:id="@+id/navReports"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:layout_marginTop="3dp"
            android:background="@drawable/nav_normal"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:text="▥    Reports"
            android:textColor="#E6EAEC"
            android:textSize="14sp"
            android:clickable="true"
            android:focusable="true" />


        <!-- ================================= -->
        <!-- MANAGE MENU -->
        <!-- ================================= -->

        <TextView
            android:id="@+id/navManageMenu"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:layout_marginTop="3dp"
            android:background="@drawable/nav_normal"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:text="⚙    Manage Menu"
            android:textColor="#E6EAEC"
            android:textSize="14sp"
            android:visibility="gone"
            android:clickable="true"
            android:focusable="true" />


        <!-- ================================= -->
        <!-- PROFILE -->
        <!-- ================================= -->

        <TextView
            android:id="@+id/navProfile"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:layout_marginTop="3dp"
            android:background="@drawable/nav_normal"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:text="●    My Profile"
            android:textColor="#E6EAEC"
            android:textSize="14sp"
            android:clickable="true"
            android:focusable="true" />


        <!-- PUSH BACK AND LOGOUT TO BOTTOM -->

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />


        <!-- ================================= -->
        <!-- BACK -->
        <!-- ================================= -->

        <TextView
            android:id="@+id/navBack"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/nav_normal"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:text="‹    Back"
            android:textColor="#E6EAEC"
            android:textSize="14sp"
            android:clickable="true"
            android:focusable="true" />


        <!-- ================================= -->
        <!-- LOGOUT -->
        <!-- ================================= -->

        <TextView
            android:id="@+id/navLogout"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:layout_marginBottom="10dp"
            android:background="@drawable/nav_logout"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:text="↪    Logout"
            android:textColor="#FF8A8A"
            android:textSize="14sp"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="true" />

    </LinearLayout>

</androidx.drawerlayout.widget.DrawerLayout>