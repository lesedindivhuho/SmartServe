<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF8E7">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Toolbar -->
        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="#2E7D32"
            android:title="Receipt"
            android:titleTextColor="#FFFFFF" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- Receipt Heading -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="SMART SERVE"
                android:textSize="30sp"
                android:textStyle="bold"
                android:gravity="center"
                android:textColor="#2E7D32" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="CAFETERIA RECEIPT"
                android:textSize="18sp"
                android:gravity="center"
                android:layout_marginTop="5dp"
                android:textColor="#444444" />

            <!-- Order Number -->
            <TextView
                android:id="@+id/tvReceiptNumber"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:padding="12dp"
                android:gravity="center"
                android:text="Order No: 001"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="#2E7D32"
                android:background="#E8F5E9" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="20dp"
                android:background="#CCCCCC" />

            <!-- Customer Details -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="CUSTOMER DETAILS"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#2E7D32" />

            <TextView
                android:id="@+id/tvCustomerName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Name:"
                android:textSize="17sp"
                android:textColor="#222222" />

            <TextView
                android:id="@+id/tvPhone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Phone:"
                android:textSize="17sp"
                android:textColor="#222222" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="20dp"
                android:background="#CCCCCC" />

            <!-- Ordered Items -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="ITEMS ORDERED"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#2E7D32" />

            <TextView
                android:id="@+id/tvItems"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="No items in order."
                android:textSize="16sp"
                android:textColor="#222222"
                android:lineSpacingExtra="6dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="20dp"
                android:background="#CCCCCC" />

            <!-- Total Amount -->
            <TextView
                android:id="@+id/tvReceiptTotal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center"
                android:text="TOTAL: R0.00"
                android:textSize="25sp"
                android:textStyle="bold"
                android:textColor="#2E7D32" />

            <!-- Thank You Message -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:gravity="center"
                android:text="Thank you for your order!"
                android:textSize="15sp"
                android:textColor="#666666" />

            <!-- Done Button -->
            <Button
                android:id="@+id/btnDone"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:layout_marginTop="25dp"
                android:text="DONE"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:backgroundTint="#2E7D32" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>
